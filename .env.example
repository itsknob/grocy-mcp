# grocy-mcp Docker environment variables
# Replace with your actual Grocy instance credentials
#
# For Docker Desktop (macOS/Linux):
#   - Use your actual Grocy instance URL
#
# For Docker Compose on a host with Grocy running:
#   - Use relative path (e.g., http://localhost:18080)
#
# See README.md for all available options
#
# Get API key from: Grocy Settings → Manage API keys

GROCY_URL=https://your-grocy-instance.com
GROCY_API_KEY=your-api-key-here

# Transport mode
# - stdio: For MCP clients (Claude Desktop, etc.)
# - streamable-http: For direct API access
TRANSPORT=stdio

# Port configuration
HTTP_PORT=8000
MCP_PORT=60999
